    {
      "title": "1. System status",
      "width": 1,
      "col_width": 16,
      "widgets": [
        {
          "type": "html",
          "settings": {
            "html": "<!-- NETPIE HTML widget: system state banner with status chips (Height Blocks: 3).\n     NETPIE replaces each dollar-brace #[...] reference with the current value before the script runs.\n     Do not write that reference syntax in comments: NETPIE evaluates it everywhere in this widget.\n     Device alias must be EV_Gateway. See dashboard/field-mapping.md section 5. -->\n<style>\n  /* NETPIE's freeboard theme draws widget text white, but its panes are white.\n     These rules make Text-widget units readable on every pane of this dashboard. */\n  .tw-unit { color: #5F6670 !important; }\n</style>\n<div id=\"sb-banner\" style=\"border-radius:10px;padding:16px 18px;font-family:Inter,system-ui,sans-serif\">\n  <div id=\"sb-title\" style=\"font:700 26px/1.25 Inter,system-ui,sans-serif\"></div>\n  <div id=\"sb-chips\" style=\"display:flex;flex-wrap:wrap;gap:8px;margin-top:12px\"></div>\n</div>\n<script>\n(function () {\n  var STALE_MS = 5000; // placeholder until the contract defines the Node timeout\n  function raw(v) { v = String(v); return (v === \"\" || v === \"null\" || v === \"undefined\") ? null : v; }\n\n  var online   = raw(\"${#[\"EV_Gateway\"][\"status\"]}\") === \"1\";\n  var state    = raw(\"${#[\"EV_Gateway\"][\"shadow\"][\"state\"]}\");\n  var cutRaw   = raw(\"${#[\"EV_Gateway\"][\"shadow\"][\"power_cut\"]}\");\n  var powerCut = cutRaw === \"true\";\n  var ageRaw   = raw(\"${#[\"EV_Gateway\"][\"shadow\"][\"node_age_ms\"]}\");\n  var ageMs    = ageRaw === null ? null : Number(ageRaw);\n  var upRaw    = raw(\"${#[\"EV_Gateway\"][\"shadow\"][\"timestamp_ms\"]}\");\n  var upS      = upRaw === null ? null : Math.floor(Number(upRaw) / 1000);\n\n  var STATES = {\n    STARTING:     [\"#1565C0\", \"#FFFFFF\", \"Starting up\"],\n    NORMAL:       [\"#1E7B34\", \"#FFFFFF\", \"Normal\"],\n    WARNING:      [\"#F2B01E\", \"#1B1F24\", \"Warning: check the battery\"],\n    HAZARD:       [\"#B3261E\", \"#FFFFFF\", powerCut ? \"HAZARD: charging power cut\" : \"HAZARD: power cut NOT confirmed\"],\n    SENSOR_ERROR: [\"#6A1B9A\", \"#FFFFFF\", \"Sensor error\"]\n  };\n  var s = STATES[state] || [\"#4F565E\", \"#FFFFFF\", state === null ? \"No data yet\" : \"Unknown state: \" + state];\n  var bg = s[0], fg = s[1], title = s[2];\n  if (!online) { bg = \"#4F565E\"; fg = \"#FFFFFF\"; title = \"OFFLINE: Gateway not connected\" + (state ? \" (last known: \" + state + \")\" : \"\"); }\n\n  var chipBg = fg === \"#FFFFFF\" ? \"rgba(255,255,255,0.16)\" : \"rgba(0,0,0,0.08)\";\n  var nodeText;\n  if (ageMs === null || isNaN(ageMs)) nodeText = \"Node data: none\";\n  else if (ageMs > STALE_MS)          nodeText = \"Node data STALE (\" + (ageMs / 1000).toFixed(1) + \" s old)\";\n  else                                nodeText = \"Node data \" + (ageMs / 1000).toFixed(1) + \" s old\";\n  var chips = [\n    [online ? \"#7CE38B\" : \"#C3C8CE\", online ? \"Gateway online\" : \"Gateway OFFLINE\"],\n    [powerCut ? \"#FFFFFF\" : null, \"Charging power: \" + (cutRaw === null ? \"unknown\" : powerCut ? \"CUT\" : \"supplied\")],\n    [null, nodeText],\n    [null, \"Uptime \" + (upS === null ? \"—\" : Math.floor(upS / 60) + \"m \" + (upS % 60) + \"s\")]\n  ];\n\n  var b = document.getElementById(\"sb-banner\");\n  b.style.background = bg;\n  b.style.color = fg;\n  document.getElementById(\"sb-title\").textContent = title;\n  var box = document.getElementById(\"sb-chips\");\n  box.innerHTML = \"\";\n  for (var i = 0; i < chips.length; i++) {\n    var c = document.createElement(\"span\");\n    c.style.cssText = \"display:inline-flex;align-items:center;gap:8px;padding:6px 12px;border-radius:8px;font:600 14px Inter,system-ui,sans-serif;background:\" + chipBg + \";color:\" + fg;\n    if (chips[i][0]) {\n      var dot = document.createElement(\"span\");\n      dot.style.cssText = \"width:10px;height:10px;border-radius:50%;background:\" + chips[i][0];\n      c.appendChild(dot);\n    }\n    c.appendChild(document.createTextNode(chips[i][1]));\n    box.appendChild(c);\n  }\n})();\n</script>\n",
            "height": 3,
            "id": "w001"
