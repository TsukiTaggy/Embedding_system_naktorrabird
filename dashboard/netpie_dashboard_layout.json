      "col": {
        "1": 1,
        "2": 1,
        "3": 1,
        "4": 1
      },
      "widgets": [
        {
          "type": "html",
          "settings": {
            "html": "<!-- NETPIE HTML widget: system state banner. Paste into an HTML widget (Height Blocks: 2).\n     NETPIE replaces each dollar-brace #[...] reference with the current value before the script runs.\n     Do not write that reference syntax in comments: NETPIE evaluates it everywhere in this widget.\n     Device alias must be EV_Gateway. See dashboard/field-mapping.md section 5. -->\n<div id=\"sb-banner\" style=\"padding:14px 10px;border-radius:6px;color:#fff;font:600 22px/1.3 sans-serif;text-align:center\"></div>\n<div id=\"sb-sub\" style=\"margin-top:6px;font:14px/1.4 sans-serif;text-align:center;color:#555\"></div>\n<script>\n(function () {\n  var STALE_MS = 5000; // placeholder until the contract defines the Node timeout\n  function raw(v) { v = String(v); return (v === \"\" || v === \"null\" || v === \"undefined\") ? null : v; }\n\n  var online   = raw(\"${#[\"EV_Gateway\"][\"status\"]}\") === \"1\";\n  var state    = raw(\"${#[\"EV_Gateway\"][\"shadow\"][\"state\"]}\");\n  var cutRaw   = raw(\"${#[\"EV_Gateway\"][\"shadow\"][\"power_cut\"]}\");\n  var powerCut = cutRaw === \"true\";\n  var ageRaw   = raw(\"${#[\"EV_Gateway\"][\"shadow\"][\"node_age_ms\"]}\");\n  var ageMs    = ageRaw === null ? null : Number(ageRaw);\n\n  var STATES = {\n    STARTING:     [\"#1565C0\", \"Starting up\"],\n    NORMAL:       [\"#2E7D32\", \"Normal\"],\n    WARNING:      [\"#F9A825\", \"Warning: check the battery\"],\n    HAZARD:       [\"#C62828\", powerCut ? \"HAZARD: charging power cut\" : \"HAZARD: power cut NOT confirmed\"],\n    SENSOR_ERROR: [\"#6A1B9A\", \"Sensor error\"]\n  };\n  var s = STATES[state] || [\"#616161\", state === null ? \"No data yet\" : \"Unknown state: \" + state];\n  var colour = s[0], text = s[1];\n  if (!online) { colour = \"#616161\"; text = \"OFFLINE: Gateway not connected\" + (state ? \" (last known: \" + state + \")\" : \"\"); }\n\n  var sub = \"Charging power: \" + (cutRaw === null ? \"unknown\" : powerCut ? \"CUT\" : \"supplied\");\n  if (ageMs === null || isNaN(ageMs)) sub += \" · Node data: none\";\n  else if (ageMs > STALE_MS)          sub += \" · Node data STALE (\" + (ageMs / 1000).toFixed(1) + \" s old)\";\n  else                                sub += \" · Node data \" + (ageMs / 1000).toFixed(1) + \" s old\";\n\n  var b = document.getElementById(\"sb-banner\");\n  b.style.background = colour;\n  b.textContent = text;\n  document.getElementById(\"sb-sub\").textContent = sub;\n})();\n</script>\n",
            "height": 2,
            "id": "w001"
          },
          "id": "w001"
        },
        {
          "type": "indicator",
          "settings": {
            "title": "Charging power",
            "value": "#[\"EV_Gateway\"][\"shadow\"][\"power_cut\"] === true",
            "oncolor": "#C62828",
            "offcolor": "#2E7D32",
            "var_oncolor": "",
            "var_offcolor": "",
            "blinking": "false",
            "blinkfrequency": "2",
            "on_text": "\"POWER CUT\"",
            "off_text": "\"CHARGING ALLOWED\"",
            "id": "w002"
          },
          "id": "w002"
        },
