      "widgets": [
        {
          "type": "html",
          "settings": {
            "html": "<!-- NETPIE HTML widget: sensor health / validity table (Diagnostics panel, Height Blocks: 4).\n     The validity object shape is a DRAFT (dashboard/field-mapping.md section 7). -->\n<table id=\"sh-table\" style=\"width:100%;border-collapse:collapse;font:14px/1.4 sans-serif\"></table>\n<script>\n(function () {\n  var STALE_MS = 5000; // keep equal to the banner's value\n  function raw(v) { v = String(v); return (v === \"\" || v === \"null\" || v === \"undefined\") ? null : v; }\n  var nodeAge = raw(\"${#[\"EV_Gateway\"][\"shadow\"][\"node_age_ms\"]}\");\n  var rows = [\n    [\"Node link (ESP-NOW)\", raw(\"${#[\"EV_Gateway\"][\"shadow\"][\"validity\"][\"node_link\"]}\"),\n      nodeAge === null ? \"no data\" : (Number(nodeAge) / 1000).toFixed(1) + \" s old\"],\n    [\"Battery temp (DS18B20)\", raw(\"${#[\"EV_Gateway\"][\"shadow\"][\"validity\"][\"temp_bat\"]}\"), \"\"],\n    [\"Gas (MQ-135, raw)\", raw(\"${#[\"EV_Gateway\"][\"shadow\"][\"validity\"][\"gas\"]}\"), \"\"],\n    [\"Flame (KY-026)\", raw(\"${#[\"EV_Gateway\"][\"shadow\"][\"validity\"][\"flame\"]}\"), \"\"],\n    [\"Ambient (DHT11)\", raw(\"${#[\"EV_Gateway\"][\"shadow\"][\"validity\"][\"ambient\"]}\"), \"\"],\n    [\"Current (ACS712)\", raw(\"${#[\"EV_Gateway\"][\"shadow\"][\"validity\"][\"current\"]}\"), \"\"]\n  ];\n  var html = \"\";\n  for (var i = 0; i < rows.length; i++) {\n    var ok = rows[i][1], label, colour;\n    if (ok === \"true\")       { label = \"OK\";      colour = \"#2E7D32\"; }\n    else if (ok === \"false\") { label = \"FAULT\";   colour = \"#C62828\"; }\n    else                     { label = \"unknown\"; colour = \"#616161\"; }\n    html += \"<tr style='border-bottom:1px solid #ddd'>\" +\n      \"<td style='padding:4px 6px'>\" + rows[i][0] + \"</td>\" +\n      \"<td style='padding:4px 6px;color:\" + colour + \";font-weight:600'>\" + label + \"</td>\" +\n      \"<td style='padding:4px 6px;color:#555'>\" + rows[i][2] + \"</td></tr>\";\n  }\n  document.getElementById(\"sh-table\").innerHTML = html;\n})();\n</script>\n",
            "height": 4,
            "id": "w017"
          },
          "id": "w017"
        },
